# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Rust
/rust/target/

# gen-l10n 生成物（flutter gen-l10n）
lib/l10n/app_localizations*.dart

# Local verification transcript (may contain local paths)
/verify-output.txt

# 本机 agent 工具状态：会话转录、计划、报告，含本机路径，不进仓库
/.mimosa/
/.zcode/
/.agents/
/.claude/

# Python 字节码缓存目录
/cache/

# POC 隔离包的生成物（flutter pub get / gen-l10n 会重建）
poc/*/build/
poc/*/lib/l10n/poc_localizations*.dart
